# =============================================================================
# Fluxity Interface — environment configuration
#
# Every variable is prefixed with NEXT_PUBLIC_ and is therefore inlined into the
# client bundle at BUILD time. Do NOT place secrets here — these values are
# public. Copy this file to `.env` and adjust as needed.
# =============================================================================

# --- External URLs -----------------------------------------------------------
NEXT_PUBLIC_LANDING=https://fluxity.finance
NEXT_PUBLIC_DOCUMENTATION=https://docs.fluxity.finance
NEXT_PUBLIC_COMMUNITY=https://discord.gg/JnT7KPEuQs
NEXT_PUBLIC_FLUXITY_API=https://api.fluxity.finance
NEXT_PUBLIC_FRIENDBOT=https://friendbot.stellar.org/?addr=
NEXT_PUBLIC_WHITEPAPER=https://docs.google.com/document/d/1Yh4wI4RR2WK4CN48HRHJMX78OHcVOYST7MN_U2KSm_4/edit?usp=sharing

# --- Fluxity contract IDs (Soroban contract addresses, format: C...) ---------
# Set NEXT_PUBLIC_MAINNET_CONTRACT to the deployed mainnet contract ID once it
# is published. Leaving it empty disables mainnet contract calls.
NEXT_PUBLIC_MAINNET_CONTRACT=
NEXT_PUBLIC_TESTNET_CONTRACT=CC63CCQDH3HLQ4XCGJWF45JYPI562RTZR3PNH7BM7RGQRHRQVHLJVZLH

# --- Network endpoints -------------------------------------------------------
# Horizon (classic) endpoints
NEXT_PUBLIC_MAINNET_HORIZONURL=https://horizon.stellar.org
NEXT_PUBLIC_TESTNET_HORIZONURL=https://horizon-testnet.stellar.org

# Soroban RPC endpoints — mainnet must point at a MAINNET RPC, not testnet.
NEXT_PUBLIC_MAINNET_SOROBAN_RPCURL=https://mainnet.sorobanrpc.com
NEXT_PUBLIC_TESTNET_SOROBAN_RPCURL=https://soroban-testnet.stellar.org
